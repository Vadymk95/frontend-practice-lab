# Optional nvm version switch (.nvmrc). Fenced with set +e: husky runs hooks under `sh -e`,
# and nvm re-arms errexit internally before returning non-zero. Replaces the hardcoded
# ~/.nvm/versions/node/v24.11.0 path that silently fell through on any other machine.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    set +e
    . "$NVM_DIR/nvm.sh" > /dev/null 2>&1
    nvm use --silent > /dev/null 2>&1
    set -e
fi

npx --no-install commitlint --edit "$1"
