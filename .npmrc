# Kept from before the harness: several peers (testing-library / vitest-axe) still declare
# ranges npm 11 refuses strictly. Re-measure on the next dependency pass and drop if clean.
legacy-peer-deps=true

# Lifecycle scripts are disabled repo-wide: install-script malware is the primary npm
# supply-chain vector. Git hooks are therefore installed by hand once after cloning:
#   npm run prepare
# (`npm run check:hooks`, the first stage of `verify`, tells you when they are not.)
ignore-scripts=true

# Refuse to install under a Node older than `engines.node` (.nvmrc = 24). Without this the
# engines field is advisory and a wrong local Node surfaces only as confusing runtime errors.
engine-strict=true

# The funding footer is noise in CI logs and in agent output.
fund=false

# Floor for a bare `npm audit`. The blocking gate is `npm run audit:gate` (high/critical,
# fail-closed, allow-list with expiry in src/scripts/audit-allowlist.json); this key only
# aligns the ad-hoc command with that policy.
audit-level=high

# Resolve only package versions released >=3 days ago (npm 11.10+; the value is DAYS).
# Urgent patch or brand-new package: npm install <pkg> --min-release-age=0
min-release-age=3
